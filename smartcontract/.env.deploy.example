# Aegis Smart Contract Deployment Variables
# Copy this file to .env.deploy and fill in your values

# ===========================================
# REQUIRED - Your Stellar Admin Account
# ===========================================
# Generate new keys: soroban keys generate --global aegis-admin --network mainnet

# Your admin public key (G...)
AEGIS_ADMIN_PUBLIC_KEY=G...

# Your admin secret key (S...) - NEVER commit this!
AEGIS_ADMIN_SECRET_KEY=S...

# ===========================================
# OPTIONAL - Already deployed contract (deployed to testnet)
# ===========================================
AEGIS_CONTRACT_ID=C...
